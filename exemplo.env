# Renomeie este arquivo para .env.local e preencha os valores.

# Chave da API da NASA — obtenha em https://api.nasa.gov/
# Sem ela, as rotas que dependem da NASA respondem 500 com mensagem explícita
# no log do servidor (ver src/lib/upstream.ts).
KEY_NASA=""

# Origem absoluta do site, sem barra no final.
# Usada em canonical, sitemap, robots e nas URLs das imagens de Open Graph.
# Em desenvolvimento: http://localhost:3000
# Em produção: o domínio real, ex. https://universo.com.br
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Origens extras permitidas pelo dev server, separadas por vírgula.
# Só necessário ao acessar o dev server de outra máquina ou túnel.
DEV_ALLOWED_ORIGINS=""
